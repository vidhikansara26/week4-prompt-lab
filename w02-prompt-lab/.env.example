# From a Linux devcontainer on Docker Desktop, use host.docker.internal.
# For native macOS execution, change this to http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434

MODEL_A=mistral:7b
MODEL_B=qwen3:8b

# Omit MODEL_A_THINK so Mistral does not send a think flag.
# Qwen3 thinking is off by default; set MODEL_B_THINK=true to measure thinking-on.
MODEL_B_THINK=false
MODEL_A_MAX_OUTPUT_TOKENS=512
MODEL_B_MAX_OUTPUT_TOKENS=512

TEMPERATURE=0.0
MAX_RETRIES=2
MAX_SCHEMA_REPAIRS=1
PER_RUN_CAP_USD=2.00
WEEKLY_CAP_USD=25.00

